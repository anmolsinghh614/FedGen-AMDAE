# Large datasets and models
data/UCI HAR/*
!data/UCI HAR/generate_niid_dirichlet.py
data/PAMAP2/

# WISDM (Jul 2026 replacement for PAMAP2). Track only the small helper
# scripts; ignore the ~11 MB tarball, the ~68 MB raw txt, and the
# generated per-(alpha, ratio) Dirichlet splits.
data/WISDM/*
!data/WISDM/download_wisdm.py
!data/WISDM/generate_niid_dirichlet.py
!data/WISDM/README.md

# Run 3 medical-imaging slots (FedISIC = ISIC 2019, ~9 GB raw JPGs;
# HAM10000 = ISIC 2018 Task 3, ~2.8 GB raw JPGs). Track only the small
# helper scripts; ignore raw pools, cached tensors, and generated
# per-(alpha, ratio) Dirichlet splits.
data/FedISIC/*
!data/FedISIC/download_fedisic.py
!data/FedISIC/generate_niid_dirichlet.py
!data/FedISIC/README.md

data/HAM10000/*
!data/HAM10000/download_ham10000.py
!data/HAM10000/generate_niid_dirichlet.py
!data/HAM10000/README.md

# CIFAR-10: torchvision auto-downloads the raw pool (~170 MB) into
# data/CIFAR10/raw/. Ignore everything except the small helper scripts.
data/CIFAR10/*
!data/CIFAR10/generate_niid_dirichlet.py
!data/CIFAR10/README.md

results/models/
models/
results/
results_test/

# PDFs and other large research files
*.pdf
